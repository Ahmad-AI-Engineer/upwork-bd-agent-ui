# Odoo webhook the poller pushes jobs to.
# Overrides crm_endpoint in config/settings.json, so the production URL
# never lives in a file the config UI rewrites.
UPWORK_CRM_ENDPOINT=https://odoo.example.com/api/upwork/webhook

# Interface the config UI binds to. It has no authentication, so keep it on
# localhost and reach it over an SSH tunnel:
#   ssh -L 8000:127.0.0.1:8000 user@server
# Set to 0.0.0.0 only if something else is handling access control.
UI_BIND=127.0.0.1
